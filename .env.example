# ========================================
# CONVERTBOT CONFIGURATION
# ========================================

# MEXC Exchange API
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_secret_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id_here

# Deposit Addresses (MEXC)
ADDR_BTC=your_btc_deposit_address
ADDR_LTC=your_ltc_deposit_address
ADDR_DASH=your_dash_deposit_address
ADDR_XMR=your_xmr_deposit_address

# ========================================
# Core Configuration
# ========================================
DRY_RUN=true
COMMISSION_PERCENT=3.0
DATABASE_URL=sqlite:///swapbot.db

# Confirmations required
REQUIRED_CONFS_BTC=2
REQUIRED_CONFS_LTC=4
REQUIRED_CONFS_DASH=12

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_COOLDOWN=30          # Seconds between swaps per user
DAILY_SWAP_LIMIT=10             # Max swaps per user per day
DAILY_VOLUME_LIMIT=10000        # Max USD volume per user per day
LARGE_SWAP_THRESHOLD=5000       # USD - swaps above this need review

# ========================================
# Redis (Optional - for distributed rate limiting)
# ========================================
REDIS_URL=redis://localhost:6379/0

# ========================================
# Monitoring (Optional)
# ========================================
METRICS_ENABLED=false
METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=text                  # text or json

# ========================================
# Secrets Management (Optional)
# ========================================
# Order of backends to try: vault,aws,file,env
SECRETS_BACKEND=env
# SECRETS_FILE=/etc/convertbot/secrets.json

# HashiCorp Vault (if using)
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=your_vault_token

# AWS Secrets Manager (if using)
# AWS_REGION=us-east-1
