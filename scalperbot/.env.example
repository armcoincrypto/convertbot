# ScalperBot Configuration

# MEXC API Credentials
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_secret_here

# Trading Mode
DRY_RUN=true  # Set to false for live trading

# Strategy Version (1.0 or 2.0)
STRATEGY_VERSION=1.0  # Set to 2.0 to use professional scalper with 4-filter system

# Trading Pairs (comma-separated)
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT

# Strategy Intervals (seconds)
STRATEGY_INTERVAL=60  # Run strategy every 60 seconds
DATA_POLL_INTERVAL=10  # Poll market data every 10 seconds

# GREEN Filter Parameters
GREEN2_BB_PERIOD=20
GREEN2_BB_STD=2.0
GREEN3_VOLUME_THRESHOLD=1.5
GREEN3_ENABLED=false  # Disable volume filter for testing
GREEN4_BREAKOUT_PERIOD=10
GREEN4_BREAKOUT_BUFFER_BPS=10

# Position Sizing
POSITION_SIZE_USD=100.0
MAX_POSITIONS=3

# Risk Management
DAILY_LOSS_LIMIT_PCT=3.0  # Stop trading if down 3% for the day

# Advanced Risk Parameters (v1.0 only - v2.0 uses pair-specific ATR-based)
MAX_SPREAD_BPS=6.0  # Maximum acceptable spread in basis points
TRAIL_STOP_BPS=15.0  # Trailing stop distance in basis points (v1.0 only)
TRAIL_ACTIVATION_BPS=15.0  # Profit threshold to activate trailing stop (v1.0 only)
TIME_STOP_SECONDS=180  # Exit if not profitable after this many seconds
TIME_STOP_MIN_PROFIT_BPS=10.0  # Minimum profit to avoid time stop (v2.0)
COOLDOWN_AFTER_LOSS_SECONDS=300  # Cooldown period after loss (5 min)

# Database
DATABASE_PATH=scalperbot/trades.db

# Telegram (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
